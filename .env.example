# ==============================================================================
# SentinelTwin Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure strong, unique secrets for your deployment.
# NEVER commit the actual .env file or real production secrets to version control.
# ==============================================================================

# Application Environment Mode (development / production / testing)
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Security Secrets (MANDATORY in production - minimum 16 characters)
# ------------------------------------------------------------------------------
# Cryptographic secret key used for session cookie signing and JWT validation:
SECRET_KEY=<generate-a-strong-random-secret>

# Pre-shared authentication token for sensor telemetry submission:
SENSOR_TOKEN=<generate-a-strong-random-token>

# JWT token expiration duration in hours
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# Administrative User Bootstrap (Optional)
# ------------------------------------------------------------------------------
# If provided on initial database initialization, an initial administrator user will be created.
# If omitted, no default user is seeded into the database.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Database & Storage Configuration
# ------------------------------------------------------------------------------
DB_PATH=data/sentineltwin.db
EVENT_RETENTION_DAYS=30
DEVICE_OFFLINE_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
